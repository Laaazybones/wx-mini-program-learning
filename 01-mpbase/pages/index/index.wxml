<!-- 第一种绑定事件写法 bind:tap -->
<button type="primary" bind:tap="handler" >点击触发事件</button>

<!-- 第二种绑定事件写法 bindtap -->
<button type="warn" bindtap="handler" >点击触发事件</button>

<!-- 小程序中输入框默认没有框线，需要在app.scss文件中定义框线 -->
<input type="text" bindinput="getInputVal"/>

