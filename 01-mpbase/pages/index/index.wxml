
<!-- 轮播图区域 -->
<view class="swiperStyle">
<!-- autoplay="true" 为true时可以省略值不写-->
<!-- circular 循环轮播 -->
<!-- interval 自动切换时间 -->
<!-- indicator-dots 选点 -->
  <swiper 
    autoplay
    circular
    interval="2000"
    indicator-dots
    indicator-color="#fff"
    indicator-active-color="#f3514f"
  >
    <swiper-item>
      <image src="/assets/banner/banner-1.jpg" mode="aspectFit"/>
    </swiper-item>
    <swiper-item>
      <image src="/assets/banner/banner-2.jpg" mode="aspectFit"/>
    </swiper-item>
    <swiper-item>
      <image src="/assets/banner/banner-3.jpg" mode="aspectFit"/>
    </swiper-item>
  </swiper>
</view>

