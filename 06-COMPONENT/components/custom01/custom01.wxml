<view>
  <!-- 具名插槽 -->
  <slot name="slot-top"/>
  <!-- slot 就是用来接收、承载子节点内容 -->
  <!-- slot 只是一个占位符，子节点内容会替换slot节点 -->
  <!-- 默认插槽 -->
  <view><slot /></view>
  <slot name="slot-bottom"/>
</view>